new file mode 100644
--- /dev/null
+++ b/models/minimax_h3/vsa/graphs.py
@@ -0,0 +1,64 @@
+"""Experimental replay of existing VSA kernels; default off and PDD heads stay eager."""
+import os
+
+from mmgp import cuda_graphs, offload
+
+
+_active_key = None
+_active_owner = None
+_reason = "VSA graph state has not been prepared"
+
+
+def enabled():
+    return os.environ.get("WGP_H3_VSA_GRAPHS") == "1"
+
+
+def _gate():
+    if offload.shared_state.get("_attention") != "vsa":
+        return None
+    return _reason if enabled() else "experimental VSA graphs are off"
+
+
+cuda_graphs.register_key(lambda: _active_key)
+cuda_graphs.register_gate(_gate)
+
+
+def prepare(owner, policy):
+    """Register only caches filled by a previous complete eager forward, outside capture."""
+    global _active_key, _active_owner, _reason
+    layout = policy.layout
+    reason = None
+    if not enabled():
+        reason = "experimental VSA graphs are off"
+    elif not policy.enabled or layout is None:
+        reason = "VSA is inactive"
+    elif policy.tile != 128 or not policy.int8_qk or policy.cuda_kind is not None:
+        reason = "experimental VSA graphs require 128-token Triton INT8 QK / FP16 PV"
+    else:
+        heads = [key for key in policy.index_cache if key[0] == "heads"]
+        if not heads or any(("prefix", key[2] - key[1]) not in policy.index_cache for key in heads):
+            reason = "VSA graph caches require a complete eager warmup"
+    if reason is not None:
+        cuda_graphs.release_state(owner, "h3_vsa")
+        _active_key, _active_owner, _reason = None, id(owner), reason
+        return False
+    cache = tuple(sorted(policy.index_cache.items()))
+    tensors = (layout.perm, layout.valid_count, layout.block_valid,
+               *(tensor for _, value in cache for tensor in (value if isinstance(value, tuple) else (value,))))
+    if not all(tensor.is_cuda for tensor in tensors):
+        cuda_graphs.release_state(owner, "h3_vsa")
+        _active_key, _active_owner, _reason = None, id(owner), "VSA graph state must be on CUDA"
+        return False
+    cuda_graphs.register_state(owner, "h3_vsa", tensors)
+    _active_key = (id(owner), id(policy), policy.signature, id(layout), layout.tile, layout.n_prefix_tiles,
+                   tuple((region.start, region.stop, region.keep) for region in layout.regions), layout.seq_len,
+                   policy.int8_qk, policy.cuda_kind, policy.sparsity, policy.ref_keep_rate,
+                   tuple(key for key, _ in cache), tuple(id(tensor) for tensor in tensors))
+    _active_owner, _reason = id(owner), None
+    return True
+
+
+def statistics(owner):
+    result = cuda_graphs.statistics(owner) or {"captures": 0, "replays": 0, "live_graphs": 0, "disabled": None}
+    return {**result, "opt_in": enabled(), "state_ready": _active_owner == id(owner) and _reason is None,
+            "fallback_reason": _reason if _active_owner == id(owner) else "VSA graph state is not active for this owner"}
